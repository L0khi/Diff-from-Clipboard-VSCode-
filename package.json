{
"name": "apply-diff-from-clipboard",
"displayName": "Apply Diff from Clipboard",
"description": "Apply messy diffs/patches (including AI-generated malformed diffs) from the clipboard to the current workspace with one shortcut.",
"version": "0.1.0",
"engines": {
"vscode": "^1.70.0"
},
"categories": ["Other"],
"activationEvents": ["onCommand:applyDiff.fromClipboard"],
"main": "./out/extension.js",
"scripts": {
"vscode:prepublish": "npm run compile",
"compile": "tsc -p ./",
"watch": "tsc -watch -p ./",
"pretest": "npm run compile",
"test": "node ./out/test/runTest.js"
},
"contributes": {
"commands": [
{
"command": "applyDiff.fromClipboard",
"title": "Apply Diff from Clipboard"
}
],
"keybindings": [
{
"command": "applyDiff.fromClipboard",
"key": "ctrl+shift+alt+d",
"when": "editorTextFocus"
}
]
},
"devDependencies": {
"@types/vscode": "^1.70.0",
"typescript": "^4.9.5",
"vscode-test": "^2.0.0"
}
}